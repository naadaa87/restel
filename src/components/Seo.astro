---
import { site, localeMeta, type Locale } from '@/config/site';
import { alternates, getDict } from '@/i18n';

interface Props {
  lang: Locale;
  title?: string;        // 페이지 제목 (접미사 자동)
  fullTitle?: string;    // 접미사 없이 그대로
  description?: string;
  path: string;          // 언어 접두어 없는 기본 경로 (예: /spaces/sinchon)
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
  keywords?: string;
  locales?: Locale[];    // 이 페이지가 있는 언어(없으면 전체)
  article?: { published: string; modified?: string; section?: string; tags?: string[] };
}
const { lang, title, fullTitle, description, path, image, type = 'website', noindex = false, jsonLd = [], keywords, locales: only, article } = Astro.props;
const t = getDict(lang);
const pageTitle = fullTitle || (title ? title + t.meta.titleSuffix : t.meta.ogTitle);
const desc = description || t.meta.description;
const alts = alternates(path, site.url, only);
const canonical = alts.find((a) => a.lang === lang)?.href || site.url + path;
const img = /^https?:/.test(image || '') ? image! : site.url + (image || site.defaultOg);
const isDefaultOg = !image || image === site.defaultOg;
const rssHref = site.url + (lang === 'ko' ? '/rss.xml' : `/${lang}/rss.xml`);
const kw = keywords || t.meta.keywords;
---
<title>{pageTitle}</title>
<meta name="description" content={desc} />
<meta name="keywords" content={kw} />
<link rel="canonical" href={canonical} />
{alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="RESTEL" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={img} />
{isDefaultOg && <meta property="og:image:width" content="1200" />}
{isDefaultOg && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content={localeMeta[lang].ogLocale} />
{alts.filter((a) => a.lang !== lang && a.lang !== ('x-default' as any)).map((a) => <meta property="og:locale:alternate" content={localeMeta[a.lang as Locale].ogLocale} />)}
{article && <meta property="article:published_time" content={article.published} />}
{article?.modified && <meta property="article:modified_time" content={article.modified} />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<link rel="alternate" type="application/rss+xml" title={t.journal.title.includes('RESTEL') ? t.journal.title : `RESTEL ${t.journal.title}`} href={rssHref} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={img} />
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.naver && <meta name="naver-site-verification" content={site.verification.naver} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
{site.verification.yandex && <meta name="yandex-verification" content={site.verification.yandex} />}
{site.verification.baidu && <meta name="baidu-site-verification" content={site.verification.baidu} />}
{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
