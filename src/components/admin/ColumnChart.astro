---
// 세로 막대 차트(서버에서 SVG로 그림). 한 가지 지표만 그린다 — 막대 끝 4px 둥글게, 바닥은 직각, 막대 사이 2px 이상 여백.
// 막대마다 넓은 투명 영역에 data-tip을 달아 마우스를 올리면 값이 보이고, 아래 "표로 보기"에 같은 값을 둔다.
interface Point { label: string; value: number; display: string; short?: string }
// width는 실제로 그려질 대략의 픽셀 너비(글자가 12px 안팎으로 보이도록 viewBox를 맞춘다)
interface Props { points: Point[]; height?: number; width?: number; unit?: 'count' | 'sec' | 'pct'; title: string; tableHead?: [string, string]; labelEvery?: number }
const { points, height = 220, width = 760, unit = 'count', title, tableHead = ['구간', '값'], labelEvery } = Astro.props;
const W = width, H = height, L = 52, R = 8, T = 14, B = 30;
const max = Math.max(0, ...points.map((p) => p.value));
// 보기 좋은 눈금(4칸)
function niceStep(m: number) {
  if (m <= 0) return 1;
  const raw = m / 4, p = Math.pow(10, Math.floor(Math.log10(raw)));
  for (const k of unit === 'count' ? [1, 2, 5, 10] : [1, 2, 2.5, 5, 10]) if (k * p >= raw) return unit === 'count' ? Math.max(1, k * p) : k * p;
  return 10 * p;
}
const step = niceStep(max);
const top = step * Math.max(1, Math.ceil(max / step));
const ticks: number[] = []; for (let v = 0; v <= top + 1e-9; v += step) ticks.push(v);
const fmtTick = (v: number) => unit === 'sec' ? (v >= 60 ? `${Math.round(v / 60)}분` : `${Math.round(v)}초`) : unit === 'pct' ? `${Math.round(v * 100)}%` : v >= 10000 ? `${Math.round(v / 1000)}K` : Math.round(v).toLocaleString('ko-KR');
const n = Math.max(points.length, 1);
const band = (W - L - R) / n;
const bw = Math.max(2, Math.min(24, band - Math.max(2, band * 0.3)));
const y = (v: number) => T + (H - T - B) * (1 - (top ? v / top : 0));
const every = labelEvery || Math.max(1, Math.ceil(n / Math.max(4, Math.floor(W / 70))));
function col(x: number, yTop: number, w: number) {
  const h = H - B - yTop; if (h <= 0) return '';
  const r = Math.min(4, w / 2, h);
  return `M${x},${H - B} L${x},${yTop + r} Q${x},${yTop} ${x + r},${yTop} L${x + w - r},${yTop} Q${x + w},${yTop} ${x + w},${yTop + r} L${x + w},${H - B} Z`;
}
const empty = max === 0;
---
<figure class="kchart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
    {ticks.map((v) => (
      <g>
        <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} class="kchart__grid" />
        <text x={L - 8} y={y(v) + 4} text-anchor="end" class="kchart__tick">{fmtTick(v)}</text>
      </g>
    ))}
    {points.map((p, i) => {
      const cx = L + band * i + band / 2;
      return (
        <g>
          {p.value > 0 && <path d={col(cx - bw / 2, y(p.value), bw)} class="kchart__bar" />}
          {(i % every === 0 || i === n - 1) && <text x={cx} y={H - 10} text-anchor="middle" class="kchart__tick">{p.short ?? p.label}</text>}
          <rect x={L + band * i} y={T} width={band} height={H - T - B} class="kchart__hit" data-tip={`${p.label} · ${p.display}`} />
        </g>
      );
    })}
    {empty && <text x={(W + L) / 2} y={(H - B) / 2 + 6} text-anchor="middle" class="kchart__empty">아직 집계된 데이터가 없습니다</text>}
  </svg>
  <details class="kchart__table">
    <summary>표로 보기</summary>
    <table class="list"><thead><tr><th>{tableHead[0]}</th><th>{tableHead[1]}</th></tr></thead>
      <tbody>{points.map((p) => <tr><td>{p.label}</td><td>{p.display}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
