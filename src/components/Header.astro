---
import type { Locale } from '@/config/site';
import { getDict, localizePath, localeList, stripLang } from '@/i18n';

interface Props { lang: Locale; path: string; locales?: Locale[]; fallback?: string }
const { lang, path, locales: only, fallback } = Astro.props;
// 이 페이지가 없는 언어를 고르면 fallback 경로(예: 저널 목록)로 보낸다
const hrefFor = (code: Locale) => (!only || only.includes(code) ? localizePath(path, code) : localizePath(fallback || '/', code));
const t = getDict(lang);
const L = (p: string) => localizePath(p, lang);
const items = [
  { href: '/about', label: t.nav.about },
  { href: '/spaces', label: t.nav.spaces },
  { href: '/sessions', label: t.nav.sessions },
  { href: '/krest', label: t.nav.krest },
  { href: '/stay', label: t.nav.stay },
  { href: '/journal', label: t.nav.journal },
  { href: '/faq', label: t.nav.faq },
  { href: '/hosts', label: t.nav.hosts },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
const current = localeList.find((l) => l.code === lang)!;
---
<header class="header">
  <div class="container header__inner">
    <a class="logo" href={L('/')} aria-label="RESTEL">
      <img src="/brand/logo-mark.webp" alt="" width="60" height="34" />
      <span>RESTEL</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {items.map((it) => <a href={L(it.href)} aria-current={isActive(it.href) ? 'page' : undefined}>{it.label}</a>)}
    </nav>
    <div class="header__actions">
      <details class="lang">
        <summary class="lang__btn" aria-label={t.nav.language}>🌐 {current.native}</summary>
        <div class="lang__menu">
          {localeList.map((l) => <a href={hrefFor(l.code)} hreflang={l.hreflang} lang={l.htmlLang} aria-current={l.code === lang ? 'true' : undefined}><span>{l.native}</span><span class="muted small">{l.code.toUpperCase()}</span></a>)}
        </div>
      </details>
      <a class="btn btn--primary btn--sm" href={L('/book/sinchon')}>{t.nav.book}</a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-nav">{t.nav.menu}</button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
    {items.map((it) => <a href={L(it.href)}>{it.label}</a>)}
    <a href={L('/guide')}>{t.nav.guide}</a>
    <a href={L('/book/sinchon')} style="color:var(--coral-dark);font-weight:700">{t.nav.book}</a>
    <a href={L('/my')}>{t.nav.myRequest}</a>
    <a href="/host/login">{t.nav.hostLogin}</a>
  </nav>
</header>
<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn'); var nav = document.getElementById('mobile-nav');
    if (btn && nav) btn.addEventListener('click', function () { var open = nav.classList.toggle('is-open'); btn.setAttribute('aria-expanded', String(open)); });
    document.addEventListener('click', function (e) { document.querySelectorAll('details.lang[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); }); });
    // 메뉴 글자가 긴 언어(러시아어·독일어 등)는 넓은 화면에서도 한 줄에 다 들어가지 않을 수 있어, 넘치면 메뉴 버튼으로 접는다
    var header = document.querySelector('.header'); var inner = header && header.querySelector('.header__inner'); var main = header && header.querySelector('.nav');
    function tight() {
      var logo = inner.querySelector('.logo'); var acts = inner.querySelector('.header__actions');
      var n = main.getBoundingClientRect(); var lg = logo ? logo.getBoundingClientRect() : null; var ac = acts ? acts.getBoundingClientRect() : null;
      return (lg && n.left - lg.right < 16) || (ac && ac.left - n.right < 16) || inner.scrollWidth > inner.clientWidth + 1;
    }
    function fit() {
      if (!header || !inner || !main) return;
      header.classList.remove('header--dense', 'header--compact');
      if (getComputedStyle(main).display === 'none') return;
      if (!tight()) return;
      header.classList.add('header--dense'); // 먼저 글자·간격을 줄여 보고
      if (tight()) header.classList.add('header--compact'); // 그래도 넘치면 메뉴 버튼으로 접는다
    }
    fit(); window.addEventListener('resize', fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  })();
</script>
