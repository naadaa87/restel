---
import { site, type Locale } from '@/config/site';
import { getDict, localizePath } from '@/i18n';
import { fmt } from '@/lib/text';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang);
const L = (p: string) => localizePath(p, lang);
const year = new Date().getFullYear();
const biz = site.business;
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a class="logo" href={L('/')}><img src="/brand/logo-full.webp" alt="RESTEL" width="86" height="28" /></a>
        <p style="margin-top:14px;max-width:420px">{t.footer.about}</p>
        <p class="small muted">{t.common.kstNote}</p>
      </div>
      <div>
        <h4>{t.footer.links}</h4>
        <ul>
          <li><a href={L('/about')}>{t.nav.about}</a></li>
          <li><a href={L('/spaces')}>{t.nav.spaces}</a></li>
          <li><a href={L('/sessions')}>{t.nav.sessions}</a></li>
          <li><a href={L('/krest')}>{t.nav.krest}</a></li>
          <li><a href={L('/guide')}>{t.nav.guide}</a></li>
          <li><a href={L('/faq')}>{t.nav.faq}</a></li>
          <li><a href={L('/my')}>{t.nav.myRequest}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.legal}</h4>
        <ul>
          <li><a href={L('/terms')}>{t.legal.termsTitle}</a></li>
          <li><a href={L('/privacy')}>{t.legal.privacyTitle}</a></li>
          <li><a href={L('/refund')}>{t.legal.refundTitle}</a></li>
          <li><a href={L('/hosts')}>{t.nav.hosts}</a></li>
          <li><a href="/host/login">{t.footer.hostPortal}</a></li>
          <li><a href="/admin/login" rel="nofollow">{t.footer.admin}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.contact}</h4>
        <ul>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><a href={`tel:${site.contact.phone.replace(/-/g, '')}`}>{site.contact.phone}</a></li>
          <li><a href={site.contact.kakao} target="_blank" rel="noopener">KakaoTalk</a></li>
          <li><a href={L('/contact')}>{t.nav.contact}</a></li>
        </ul>
        {(biz.company || biz.regNo) && (
          <>
            <h4 style="margin-top:18px">{t.footer.business}</h4>
            <p class="small muted">{[biz.company, biz.ceo, biz.regNo && `사업자등록번호 ${biz.regNo}`, biz.mailOrderNo && `통신판매업신고 ${biz.mailOrderNo}`, biz.address].filter(Boolean).join(' · ')}</p>
          </>
        )}
      </div>
    </div>
    <div class="footer__bottom">
      <span>{fmt(t.footer.copyright, { year })}</span>
      <span>{t.common.notLodging}</span>
    </div>
  </div>
</footer>
