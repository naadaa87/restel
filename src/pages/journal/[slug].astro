---
import View from '@/views/JournalArticleView.astro';
import { articlesFor } from '@/lib/journal';
export async function getStaticPaths() {
  const list = await articlesFor('ko');
  return list.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props as any;
---
<View lang="ko" article={article} />
