---
export const prerender = false;
import View from '@/views/SpaceDetailView.astro';
import NotFound from '@/views/NotFoundView.astro';
import { getSpaceBySlug } from '@/lib/spaces';
const lang = 'ko' as const;
const space = await getSpaceBySlug(Astro.locals, Astro.params.slug as string, lang);
if (!space) Astro.response.status = 404;
---
{space ? <View lang={lang} space={space} /> : <NotFound lang={lang} />}
