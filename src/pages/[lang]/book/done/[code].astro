---
export const prerender = false;
import View from '@/views/BookDoneView.astro';
import { isLocale } from '@/i18n';
const langParam = Astro.params.lang as string;
if (!isLocale(langParam) || langParam === 'ko') return new Response(null, { status: 404 });
const lang = langParam;
const code = String(Astro.params.code || '').toUpperCase();
---
<View lang={lang} code={code} />
