---
export const prerender = false;
import View from '@/views/SpacesView.astro';
import { getAllSpaces } from '@/lib/spaces';
import { isLocale } from '@/i18n';
const langParam = Astro.params.lang as string;
if (!isLocale(langParam) || langParam === 'ko') return new Response(null, { status: 404 });
const lang = langParam;
const spaces = await getAllSpaces(Astro.locals, lang);
---
<View lang={lang} spaces={spaces} />
