---
export const prerender = false;
import Portal from '@/layouts/Portal.astro';
import { db, getHost, updateHostProfile, updateHostPayment, updateHostPassword, parseJson, audit } from '@/lib/db';
import { flash, redirectWith, str, num, BIZ_TYPES, SPACE_KINDS, PLEDGES, hostPayment, hostBank } from '@/lib/portal';
import { hashPassword, verifyPassword, sameOrigin } from '@/lib/auth';
import { fmtDate } from '@/lib/text';

const me = (Astro.locals as any).host;
const d = await db(Astro.locals);
if (!d) return redirectWith('/host', undefined, '데이터베이스가 연결되지 않았습니다.');
const host = await getHost(d, me.id);
const { msg, err } = flash(Astro.url);
if (Astro.request.method === 'POST' && host) {
  if (!sameOrigin(Astro.request)) return redirectWith('/host/settings', undefined, '잘못된 요청입니다.');
  const fd = await Astro.request.formData();
  const op = str(fd, 'op');
  if (op === 'profile') {
    const prev = parseJson<any>(host.profile_json, {});
    const profile = { ...prev, website: str(fd, 'website'), intro: str(fd, 'intro'), notifyEmail: !!fd.get('notify_email') };
    await updateHostProfile(d, me.id, { name: str(fd, 'name'), phone: str(fd, 'phone'), company: str(fd, 'company'), biz_type: str(fd, 'biz_type'), biz_no: str(fd, 'biz_no'), biz_address: str(fd, 'biz_address'), space_kind: str(fd, 'space_kind'), region: str(fd, 'region'), profile_json: JSON.stringify(profile) });
    await audit(d, `host:${me.email}`, 'host.profile', String(me.id));
    return redirectWith('/host/settings', '프로필과 사업 정보를 저장했습니다.');
  }
  if (op === 'payment') {
    const methods = ['transfer', 'onsite'].filter((m) => !!fd.get(`m_${m}`));
    if (!methods.length) return redirectWith('/host/settings#payment', undefined, '결제 방법을 하나 이상 선택해 주세요.');
    const payment = { methods, bank: str(fd, 'p_bank'), holder: str(fd, 'p_holder'), account: str(fd, 'p_account'), deadlineHours: num(fd, 'deadline', 24) || 24, onsiteNote: str(fd, 'onsite_note'), refundPolicy: str(fd, 'refund_policy') };
    if (methods.includes('transfer') && !payment.account) return redirectWith('/host/settings#payment', undefined, '계좌이체를 받으려면 입금 계좌를 적어 주세요.');
    const sameAsPay = !!fd.get('same_as_payment');
    const bank = sameAsPay ? { bank: payment.bank, holder: payment.holder, account: payment.account, taxType: str(fd, 'tax_type') } : { bank: str(fd, 'b_bank'), holder: str(fd, 'b_holder'), account: str(fd, 'b_account'), taxType: str(fd, 'tax_type') };
    await updateHostPayment(d, me.id, JSON.stringify(payment), JSON.stringify(bank));
    await audit(d, `host:${me.email}`, 'host.payment', String(me.id));
    return redirectWith('/host/settings#payment', '결제·정산 정보를 저장했습니다.');
  }
  if (op === 'password') {
    const cur = str(fd, 'current'), nw = str(fd, 'new');
    if (!(await verifyPassword(cur, host.password_hash))) return redirectWith('/host/settings#security', undefined, '현재 비밀번호가 맞지 않습니다.');
    if (nw.length < 8) return redirectWith('/host/settings#security', undefined, '새 비밀번호는 8자 이상이어야 합니다.');
    await updateHostPassword(d, me.id, await hashPassword(nw));
    await audit(d, `host:${me.email}`, 'host.password', String(me.id));
    return redirectWith('/host/settings#security', '비밀번호를 변경했습니다.');
  }
}
const profile = parseJson<any>(host?.profile_json, {});
const pay = hostPayment(host); const bank = hostBank(host);
const pledge = parseJson<any>(host?.pledge_json, {});
const sameAsPay = !bank.account || (bank.account === pay.account && bank.bank === pay.bank);
---
<Portal title="설정" kind="host" user={me} current="settings" msg={msg} err={err}>
  <h1>설정</h1>
  <div data-tabs>
    <div class="tabs"><button class="is-active">프로필·사업 정보</button><button>결제·정산</button><button>운영 기준 서약</button><button>보안</button></div>

    <div class="tabpanel is-active panel" id="profile">
      <form method="post" class="form">
        <input type="hidden" name="op" value="profile" />
        <h2 class="h3">담당자</h2>
        <div class="form__row">
          <div class="field"><label>이메일 (로그인 아이디)</label><input value={host?.email} readonly /></div>
          <div class="field"><label>담당자 이름 <span class="req">*</span></label><input name="name" value={host?.name} required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label>연락처 <span class="req">*</span></label><input name="phone" value={host?.phone} required /><div class="hint">입장 안내 템플릿의 문의 번호로 들어갑니다.</div></div>
          <div class="field"><label>웹사이트·인스타그램</label><input name="website" value={profile.website || ''} placeholder="https://" /></div>
        </div>
        <h2 class="h3" style="margin-top:8px">사업 정보 <span class="help">정산·세금 처리에 필요합니다</span></h2>
        <div class="form__row">
          <div class="field"><label>사업 형태 <span class="req">*</span></label><select name="biz_type" required><option value="">선택</option>{BIZ_TYPES.map((b) => <option value={b.code} selected={host?.biz_type === b.code}>{b.label}</option>)}</select></div>
          <div class="field"><label>상호·법인명</label><input name="company" value={host?.company} /></div>
        </div>
        <div class="form__row">
          <div class="field"><label>사업자등록번호</label><input name="biz_no" value={host?.biz_no} placeholder="000-00-00000" /></div>
          <div class="field"><label>사업장 주소</label><input name="biz_address" value={host?.biz_address} /></div>
        </div>
        <div class="form__row">
          <div class="field"><label>운영 중인 공간 형태</label><select name="space_kind"><option value="">선택</option>{SPACE_KINDS.map((k) => <option value={k.code} selected={host?.space_kind === k.code}>{k.label}</option>)}</select></div>
          <div class="field"><label>공간 위치(지역)</label><input name="region" value={host?.region} /></div>
        </div>
        <div class="field"><label>공간 소개·전환 계획 (검토 참고용)</label><textarea name="intro" rows="3">{profile.intro || ''}</textarea></div>
        <label class="checkbox"><input type="checkbox" name="notify_email" checked={profile.notifyEmail !== false} /> <span>새 예약 요청·고객 메시지·검토 결과를 이메일로 받습니다.</span></label>
        <button class="btn btn--primary btn--sm" type="submit" style="justify-self:start">저장</button>
      </form>
    </div>

    <div class="tabpanel panel" id="payment">
      <form method="post" class="form">
        <input type="hidden" name="op" value="payment" />
        <h2 class="h3">고객 결제 방법</h2>
        <p class="help">레스텔 1차 운영은 "확정 → 결제 안내 → 입금 확인" 방식입니다. 온라인 카드 결제(토스페이먼츠)는 레스텔 본사 연동 후 자동으로 열립니다.</p>
        <div class="pledge">
          <label><input type="checkbox" name="m_transfer" checked={pay.methods.includes('transfer')} /> <span><strong>계좌이체</strong> — 확정 후 아래 계좌로 입금받고 "입금 확인"을 누릅니다. 외국인 고객은 해외 송금이 어려울 수 있어 현장 결제를 함께 열어 두는 것을 권장합니다.</span></label>
          <label><input type="checkbox" name="m_onsite" checked={pay.methods.includes('onsite')} /> <span><strong>현장 결제</strong> — 입장 때 카드·현금으로 받고 이용 완료 처리 시 금액을 입력합니다.</span></label>
          <label style="opacity:.6"><input type="checkbox" disabled /> <span><strong>온라인 카드 결제</strong> — 준비 중 (토스페이먼츠 연동 후 제공)</span></label>
        </div>
        <div class="form__row">
          <div class="field"><label>입금 은행</label><input name="p_bank" value={pay.bank} placeholder="예: 카카오뱅크" /></div>
          <div class="field"><label>예금주</label><input name="p_holder" value={pay.holder} placeholder="예: 주식회사 ○○" /></div>
        </div>
        <div class="form__row">
          <div class="field"><label>입금 계좌번호</label><input name="p_account" value={pay.account} placeholder="숫자와 하이픈" /><div class="hint">결제 안내 메시지에 그대로 들어갑니다.</div></div>
          <div class="field"><label>입금 기한 (확정 후 시간)</label><input name="deadline" value={pay.deadlineHours} inputmode="numeric" /><div class="hint">기본 24시간. 당일 요청은 더 짧게 안내하세요.</div></div>
        </div>
        <div class="field"><label>현장 결제 안내 문구 (선택)</label><input name="onsite_note" value={pay.onsiteNote} placeholder="예: 카드 결제 가능, 현금 영수증 발행" /></div>
        <div class="field"><label>환불 규정 (비우면 레스텔 표준: 48h 전 100% · 24h 전 50% · 이후 0%)</label><textarea name="refund_policy" rows="2">{pay.refundPolicy}</textarea></div>
        <h2 class="h3" style="margin-top:8px">정산 받을 계좌 <span class="help">레스텔이 수수료를 정산할 때 사용</span></h2>
        <label class="checkbox"><input type="checkbox" name="same_as_payment" checked={sameAsPay} onchange="document.getElementById('bankfields').style.display=this.checked?'none':'grid'" /> <span>위 입금 계좌와 같습니다</span></label>
        <div id="bankfields" class="form" style={sameAsPay ? 'display:none' : ''}>
          <div class="form__row"><div class="field"><label>은행</label><input name="b_bank" value={bank.bank} /></div><div class="field"><label>예금주</label><input name="b_holder" value={bank.holder} /></div></div>
          <div class="field"><label>계좌번호</label><input name="b_account" value={bank.account} /></div>
        </div>
        <div class="field"><label>세금 처리</label><select name="tax_type"><option value="">선택</option><option value="invoice" selected={bank.taxType === 'invoice'}>세금계산서 발행 (사업자)</option><option value="withholding" selected={bank.taxType === 'withholding'}>원천징수 (개인)</option></select></div>
        <button class="btn btn--primary btn--sm" type="submit" style="justify-self:start">저장</button>
      </form>
    </div>

    <div class="tabpanel panel" id="pledge">
      <h2 class="h3" style="margin-bottom:6px">레스텔 운영 기준 서약</h2>
      <p class="help" style="margin-bottom:12px">{pledge.agreedAt ? `${fmtDate(pledge.agreedAt)}에 동의했습니다.` : '가입 시 동의한 내용입니다.'} 기준이 바뀌면 다시 동의를 요청드립니다.</p>
      <ul class="check" style="gap:10px">{PLEDGES.map((p) => <li>{p.text}</li>)}</ul>
      <p class="small muted" style="margin-top:12px">기준의 배경과 운영 방법은 <a href="/host/center/guide" style="text-decoration:underline">운영 가이드</a>에 있습니다.</p>
    </div>

    <div class="tabpanel panel" id="security">
      <h2 class="h3" style="margin-bottom:12px">비밀번호 변경</h2>
      <form method="post" class="form" style="max-width:420px">
        <input type="hidden" name="op" value="password" />
        <div class="field"><label>현재 비밀번호</label><input type="password" name="current" required autocomplete="current-password" /></div>
        <div class="field"><label>새 비밀번호 (8자 이상)</label><input type="password" name="new" required minlength="8" autocomplete="new-password" /></div>
        <button class="btn btn--ghost btn--sm" type="submit" style="justify-self:start">변경</button>
      </form>
      <p class="small muted" style="margin-top:14px">가입일 {host && fmtDate(host.created_at)} · 마지막 로그인 {host?.last_login_at ? fmtDate(host.last_login_at) : '—'}</p>
    </div>
  </div>
</Portal>
