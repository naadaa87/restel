---
export const prerender = false;
import Portal from '@/layouts/Portal.astro';
import { db, getHostByEmail, touchHostLogin } from '@/lib/db';
import { verifyPassword, signSession, setCookieHeader, cookieName, sameOrigin } from '@/lib/auth';
import { str, flash } from '@/lib/portal';

const env = (Astro.locals as any).runtime?.env || {};
if ((Astro.locals as any).host) return Astro.redirect('/host');
let err = flash(Astro.url).err;
const msg = flash(Astro.url).msg;
let email = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  email = str(fd, 'email'); const pw = str(fd, 'password');
  const d = await db(Astro.locals);
  if (!d) err = '데이터베이스가 아직 연결되지 않았습니다. Cloudflare 배포 설정을 확인해 주세요.';
  else if (!sameOrigin(Astro.request)) err = '잘못된 요청입니다.';
  else {
    const h = await getHostByEmail(d, email);
    if (!h || !(await verifyPassword(pw, h.password_hash))) err = '이메일 또는 비밀번호가 맞지 않습니다.';
    else {
      await touchHostLogin(d, h.id);
      const token = await signSession(env, { t: 'host', id: h.id, email: h.email, name: h.name, exp: Date.now() + 30 * 86400 * 1000 });
      const next = Astro.url.searchParams.get('next') || '/host';
      return new Response(null, { status: 303, headers: { Location: next.startsWith('/host') ? next : '/host', 'Set-Cookie': setCookieHeader(cookieName('host'), token, 30 * 86400, Astro.url.protocol === 'https:') } });
    }
  }
}
---
<Portal title="호스트 로그인" kind="host" msg={msg} err={err}>
  <div class="auth">
    <div class="panel">
      <h1>호스트 로그인</h1>
      <form method="post" class="form">
        <div class="field"><label>이메일</label><input type="email" name="email" value={email} required autocomplete="username" /></div>
        <div class="field"><label>비밀번호</label><input type="password" name="password" required autocomplete="current-password" /></div>
        <button class="btn btn--primary btn--block" type="submit">로그인</button>
      </form>
      <p class="small muted" style="margin-top:16px">아직 계정이 없나요? <a href="/host/register" style="text-decoration:underline">호스트 가입</a> · <a href="/hosts" style="text-decoration:underline">입점 안내</a></p>
    </div>
  </div>
</Portal>
