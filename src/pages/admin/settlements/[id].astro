---
export const prerender = false;
import Portal from '@/layouts/Portal.astro';
import { db, getSettlement, listCompletedBookingsForPeriod, getHost } from '@/lib/db';
import { flash, redirectWith, STATUS_KO, METHOD_KO, hostBank } from '@/lib/portal';
import { fmtDate } from '@/lib/text';
import { formatKRW } from '@/i18n';

const me = (Astro.locals as any).admin;
const id = Number(Astro.params.id);
const d = await db(Astro.locals);
if (!d) return redirectWith('/admin', undefined, 'D1 미연결');
const s = await getSettlement(d, id);
if (!s) return redirectWith('/admin/settlements', undefined, '정산서를 찾을 수 없습니다.');
const { msg, err } = flash(Astro.url);
const host = await getHost(d, s.host_id);
const bank = hostBank(host);
const bookings = await listCompletedBookingsForPeriod(d, s.host_id, s.period);
const bankText = bank.account ? [bank.bank, bank.account, '(' + bank.holder + ')'].join(' ') : '미등록';
const taxText = bank.taxType === 'invoice' ? '세금계산서' : bank.taxType === 'withholding' ? '원천징수' : '세금 처리 미정';
---
<Portal title={`정산서 ${s.period} · ${s.host_name}`} kind="admin" user={me} current="settlements" msg={msg} err={err}>
  <a class="small muted" href="/admin/settlements">← 정산 관리</a>
  <div class="toolbar" style="margin-top:8px"><h1 style="margin:0">{s.period} 정산서 — {s.host_name} <span class={`status status--${s.status === 'paid' ? 'completed' : 'confirmed'}`}>{STATUS_KO[s.status]}</span></h1><button class="btn btn--ghost btn--sm no-print" onclick="window.print()">인쇄</button></div>
  <div class="grid grid--4" style="margin-bottom:18px">
    <div class="stat"><b>{s.booking_count}</b><span>완료 세션</span></div>
    <div class="stat"><b>{formatKRW(s.gross)}</b><span>매출 (환불 차감)</span></div>
    <div class="stat"><b>{formatKRW(s.commission)}</b><span>수수료 {s.commission_rate}%</span></div>
    <div class="stat"><b>{formatKRW(s.net)}</b><span>정산액</span></div>
  </div>
  <div class="panel" style="margin-bottom:18px">
    <dl class="kv">
      <dt>호스트</dt><dd>{s.host_name} · {s.host_email} · {host?.company}</dd>
      <dt>정산 계좌</dt><dd>{bankText} · {taxText}</dd>
      <dt>발행</dt><dd>{fmtDate(s.created_at)}{s.paid_at && ` · 지급 ${fmtDate(s.paid_at)}`}</dd>
      <dt>메모</dt><dd>{s.note || '—'}</dd>
    </dl>
  </div>
  <div class="panel">
    <table class="list">
      <thead><tr><th>일시</th><th>번호</th><th>공간 · 세션</th><th>고객</th><th>결제</th><th>금액</th><th>환불</th><th>순액</th></tr></thead>
      <tbody>{bookings.map((b) => <tr><td>{b.date} {b.start_time}</td><td><a href={`/admin/bookings/${b.id}`}>{b.code}</a></td><td>{b.space_name}<br /><span class="small muted">{b.session_code} · {b.people}인</span></td><td>{b.name}</td><td class="small">{METHOD_KO[b.payment_method] || '—'}</td><td>{formatKRW(b.paid_amount)}</td><td>{b.refund_amount ? formatKRW(b.refund_amount) : '—'}</td><td><strong>{formatKRW(b.paid_amount - b.refund_amount)}</strong></td></tr>)}</tbody>
    </table>
  </div>
</Portal>
