---
export const prerender = false;
import { site } from '@/config/site';
import Portal from '@/layouts/Portal.astro';
import SpaceForm from '@/components/SpaceForm.astro';
import { db, getSpace, updateSpace, updateSpaceStatus, deleteSpace, slugExists, audit, getHost, parseJson } from '@/lib/db';
import { spaceFromForm, spaceReadiness, redirectWith, flash, STATUS_KO, str, COMPLIANCE } from '@/lib/portal';
import { sameOrigin } from '@/lib/auth';
import { sendMail } from '@/lib/email';
import { rowToView } from '@/lib/spaces';

const me = (Astro.locals as any).admin;
const env = (Astro.locals as any).runtime?.env || {};
const id = Number(Astro.params.id);
const d = await db(Astro.locals);
if (!d) return redirectWith('/admin', undefined, 'D1 미연결');
const space = await getSpace(d, id);
if (!space) return redirectWith('/admin/spaces', undefined, '공간을 찾을 수 없습니다.');
const { msg, err } = flash(Astro.url);
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return redirectWith(`/admin/spaces/${id}`, undefined, '잘못된 요청');
  const fd = await Astro.request.formData();
  const op = str(fd, 'op');
  if (op === 'status') {
    const s = str(fd, 'status'); const note = str(fd, 'note');
    if (['draft', 'submitted', 'published', 'hidden', 'rejected'].includes(s)) {
      await updateSpaceStatus(d, id, s, note);
      await audit(d, `admin:${me.email}`, 'space.status', String(id), `${s} ${note}`);
      const h = await getHost(d, space.host_id);
      if (h?.email && (s === 'published' || s === 'rejected')) await sendMail(env, { to: h.email, subject: `[RESTEL] 공간 검토 결과 · ${STATUS_KO[s]}`, text: `${JSON.parse(space.name_json || '{}').ko || space.slug}: ${STATUS_KO[s]}\n${note ? '메모: ' + note + '\n' : ''}\n${env.SITE_URL || site.url}/host/spaces/${id}` });
      return redirectWith(`/admin/spaces/${id}`, `상태를 "${STATUS_KO[s]}"(으)로 바꿨습니다.`);
    }
  }
  if (op === 'delete') { await deleteSpace(d, id); await audit(d, `admin:${me.email}`, 'space.delete', String(id)); return redirectWith('/admin/spaces', '공간을 삭제했습니다.'); }
  const data = spaceFromForm(fd);
  if (await slugExists(d, data.slug, id)) return redirectWith(`/admin/spaces/${id}`, undefined, '이미 사용 중인 슬러그입니다.');
  await updateSpace(d, id, data);
  await audit(d, `admin:${me.email}`, 'space.update', String(id));
  return redirectWith(`/admin/spaces/${id}`, '저장되었습니다.');
}
const name = JSON.parse(space.name_json || '{}').ko || space.slug;
const view = rowToView(space, 'ko');
const photos = parseJson<any[]>(space.photos_json, []);
const compliance = parseJson<any>(space.compliance_json, {});
const missing = spaceReadiness(space);
const blocked = parseJson<any>(space.blocked_json, {});
const entry = parseJson<any>(space.entry_json, {});
---
<Portal title={`공간 검토 — ${name}`} kind="admin" user={me} current="spaces" msg={msg} err={err}>
  <a class="small muted" href="/admin/spaces">← 공간 목록</a>
  <div class="toolbar" style="margin-top:8px">
    <div><h1 style="margin:0 0 4px">{name}</h1><span class={`status status--${space.status}`}>{STATUS_KO[space.status]}</span> <span class="small muted">/{space.slug} · 호스트 {space.host_name} ({space.host_email})</span></div>
    {space.status === 'published' && <a class="btn btn--ghost btn--sm" href={`/spaces/${space.slug}`} target="_blank">공개 페이지 ↗</a>}
  </div>
  <div class="grid grid--2" style="margin-bottom:18px">
    <div class="panel">
      <h2 class="h3" style="margin-bottom:10px">검토 결정</h2>
      <form method="post" class="form">
        <input type="hidden" name="op" value="status" />
        <div class="field"><label>상태</label><select name="status">{['submitted', 'published', 'hidden', 'rejected', 'draft'].map((s) => <option value={s} selected={space.status === s}>{STATUS_KO[s]}</option>)}</select></div>
        <div class="field"><label>호스트에게 남길 메모</label><textarea name="note" rows="3" placeholder="예: 조명 3단계 사진과 암막 확인 사진을 추가해 주세요.">{space.admin_note}</textarea></div>
        <button class="btn btn--primary btn--sm" type="submit" style="justify-self:start">결정 저장</button>
      </form>
      <h3 class="h3" style="margin:18px 0 8px;font-size:16px">호스트 자가 점검 결과 {missing.length === 0 ? <span class="status status--approved">필수 항목 충족</span> : <span class="status status--pending">미비 {missing.length}</span>}</h3>
      {missing.length > 0 && <ul class="small" style="margin:0 0 10px 18px;color:var(--coral-dark)">{missing.map((m) => <li>{m}</li>)}</ul>}
      <table class="list" style="font-size:13px"><tbody>{COMPLIANCE.map((c) => <tr><td style="width:24px">{compliance[c.key] ? '✓' : '—'}</td><td>{c.required ? <strong style="color:var(--coral-dark)">● </strong> : '○ '}{c.text}</td></tr>)}</tbody></table>
      {compliance.note && <p class="small" style="margin-top:8px"><strong>호스트 메모:</strong> {compliance.note}</p>}
      <p class="small muted" style="margin-top:8px">휴무 요일 {(blocked.weekdays || []).length ? (blocked.weekdays || []).map((w: number) => ['일','월','화','수','목','금','토'][w]).join('·') : '없음'} · 휴무일 {(blocked.dates || []).length}일 · 정리 {space.buffer_min}분 · 입장 안내 {Object.keys(entry).length}개 언어</p>
      <p class="small muted">검토자 확인: 사진에 침대·호텔식 침구·샤워 부스가 없는지, 운영 종료가 자정 이전인지, 세션 가격이 권장 범위인지, 영어 소개가 있는지.</p>
    </div>
    <div class="panel">
      <h2 class="h3" style="margin-bottom:10px">미리보기(한국어)</h2>
      {photos.length > 0 && <div class="photos-grid" style="margin-bottom:10px">{photos.slice(0, 6).map((p: any) => <figure><img src={p.sm || p.src} alt="" /></figure>)}</div>}
      <p><strong>{view.name}</strong> — {view.tagline}</p>
      {view.description.map((p) => <p class="small">{p}</p>)}
      <p class="small muted">세션 {view.sessions.length}개 · 기본 {view.capacityBase}인 · 최대 {view.capacityMax}인 · {view.hours.open}–{view.hours.close}</p>
      <form method="post" data-confirm="공간을 완전히 삭제할까요?" style="margin-top:10px"><input type="hidden" name="op" value="delete" /><button class="btn btn--ghost btn--sm" type="submit">삭제</button></form>
    </div>
  </div>
  <SpaceForm space={space} action={`/admin/spaces/${id}`} isAdmin />
</Portal>
