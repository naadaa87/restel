---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, localeMeta, type Locale } from '@/config/site';
import { getDict, localizePath, localeList } from '@/i18n';

interface Props {
  lang: Locale;
  path: string;              // 언어 접두어 없는 경로
  title?: string;
  fullTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
  keywords?: string;
  hideNotice?: boolean;
  bodyClass?: string;
  locales?: Locale[];        // 이 페이지가 있는 언어(없으면 전체)
  langFallback?: string;     // 없는 언어로 바꿀 때 보낼 경로
  type?: 'website' | 'article';
  article?: { published: string; modified?: string; section?: string; tags?: string[] };
}
const { lang, path, title, fullTitle, description, image, noindex, jsonLd = [], keywords, hideNotice = false, bodyClass = '', locales: only, langFallback, type, article } = Astro.props;
const t = getDict(lang);
const meta = localeMeta[lang];
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'RESTEL',
  alternateName: ['레스텔', 'Restel'],
  url: site.url,
  logo: site.url + '/brand/logo-full.png',
  description: t.meta.description,
  email: site.contact.email,
  telephone: site.contact.phone,
  sameAs: [site.contact.instagram, site.contact.kakao].filter(Boolean),
  // 문의 응대는 한국어·영어, 홈페이지 안내는 12개 언어
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: site.contact.email, availableLanguage: ['ko', 'en'] },
  knowsLanguage: ['ko', 'en'],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RESTEL',
  url: site.url,
  inLanguage: localeList.map((l) => l.htmlLang),
};
const fonts = meta.font ? `https://fonts.googleapis.com/css2?family=${meta.font}&display=swap` : null;
---
<!doctype html>
<html lang={meta.htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts && <link rel="stylesheet" href={fonts} />}
    <Seo lang={lang} path={path} title={title} fullTitle={fullTitle} description={description} image={image} noindex={noindex} keywords={keywords} locales={only} type={type} article={article} jsonLd={[orgLd, websiteLd, ...jsonLd]} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class={bodyClass}>
    <div id="lang-banner" class="lang-banner" hidden>
      <div class="container">
        <span id="lang-banner-text"></span>
        <a id="lang-banner-link" href="#">{t.common.langSwitch}</a>
        <button id="lang-banner-close" aria-label={t.common.dismiss}>✕</button>
      </div>
    </div>
    <Header lang={lang} path={path} locales={only} fallback={langFallback} />
    {!hideNotice && <div class="notice"><strong>RESTEL</strong> · {t.common.notLodging}</div>}
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline define:vars={{ lang, path, avail: only || null, fallback: langFallback || '/', locales: localeList.map((l) => ({ code: l.code, native: l.native, html: l.htmlLang })), suggestTpl: t.common.langSuggest }}>
      (function () {
        try {
          var KEY = 'restel_lang';
          var saved = localStorage.getItem(KEY);
          if (saved !== lang) localStorage.setItem(KEY, lang);
          if (sessionStorage.getItem('restel_lang_banner_dismissed')) return;
          if (saved && saved !== lang) return; // 이미 선택한 언어가 있으면 제안하지 않음
          var nav = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          nav = nav.toLowerCase();
          var map = { ko: 'ko', en: 'en', ja: 'ja', th: 'th', vi: 'vi', id: 'id', ms: 'id', ru: 'ru', uk: 'ru', be: 'ru', kk: 'ru', ky: 'ru', uz: 'ru', mn: 'ru', es: 'es', ca: 'es', gl: 'es', fr: 'fr', de: 'de' };
          var target = null;
          if (nav.startsWith('zh')) target = (nav.includes('tw') || nav.includes('hk') || nav.includes('hant') || nav.includes('mo')) ? 'zh-tw' : 'zh-cn';
          else target = map[nav.split('-')[0]] || null;
          if (!target || target === lang) return;
          var loc = locales.find(function (l) { return l.code === target; });
          if (!loc) return;
          var p = (avail && avail.indexOf(target) < 0) ? fallback : path;
          var href = target === 'ko' ? p : '/' + target + (p === '/' ? '' : p);
          var el = document.getElementById('lang-banner');
          document.getElementById('lang-banner-text').textContent = suggestTpl.replace('{lang}', loc.native);
          document.getElementById('lang-banner-link').setAttribute('href', href);
          el.hidden = false;
          document.getElementById('lang-banner-close').addEventListener('click', function () { el.hidden = true; sessionStorage.setItem('restel_lang_banner_dismissed', '1'); });
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // 방문 통계(쿠키 없음). 수집 항목: 페이지 경로·제목, 이전 페이지 주소, UTM, 브라우저 언어, 화면 너비, 체류 시간, 스크롤 깊이, 클릭한 버튼·링크
      (function () {
        try { if (navigator.webdriver || localStorage.getItem('restel_notrack') === '1') return; } catch (e) {}
        var E = '/api/collect';
        function rid() { var a = new Uint8Array(8); crypto.getRandomValues(a); return Array.prototype.map.call(a, function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); }
        function post(o) { return fetch(E, { method: 'POST', body: JSON.stringify(o), keepalive: true, credentials: 'same-origin', headers: { 'content-type': 'text/plain' } }).catch(function () {}); }
        function beacon(o) { var b = JSON.stringify(o); if (navigator.sendBeacon && navigator.sendBeacon(E, new Blob([b], { type: 'text/plain' }))) return; post(o); }
        var q = new URLSearchParams(location.search), id = rid(), P = location.pathname;
        var first = post({ t: 'pv', id: id, p: P, ti: document.title, r: document.referrer, us: q.get('utm_source') || '', um: q.get('utm_medium') || '', uc: q.get('utm_campaign') || '', l: navigator.language || '', w: screen.width || 0, nf: document.querySelector('[data-notfound]') ? 1 : 0 });
        // 전환: 예약 요청·문의·스테이 알림 신청 완료 화면
        var cv = document.querySelector('[data-convert]');
        if (cv) first.then(function () { post({ t: 'cv', id: id, p: P, lb: cv.getAttribute('data-convert') }); });
        // 체류 시간(화면에 보이는 동안만)과 스크롤 깊이
        var since = document.visibilityState === 'visible' ? Date.now() : 0, total = 0, maxS = 0;
        function sc() { var h = document.documentElement; var v = Math.round((window.scrollY + window.innerHeight) / Math.max(h.scrollHeight, 1) * 100); if (v > maxS) maxS = Math.min(100, v); }
        sc(); addEventListener('scroll', sc, { passive: true });
        function flush() { if (since) { total += Date.now() - since; since = 0; } if (total > 500) beacon({ t: 'en', id: id, p: P, d: Math.min(total, 1800000), s: maxS }); }
        document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flush(); else since = Date.now(); });
        addEventListener('pagehide', flush);
        // 클릭한 버튼·링크
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('a[href],button,[data-track]') : null;
          if (!el || el.closest('[data-notrack]')) return;
          var label = el.getAttribute('data-track') || el.getAttribute('aria-label') || (el.textContent || '').replace(/\s+/g, ' ').trim() || el.getAttribute('title') || '';
          var zone = el.closest('.header,.mobile-nav') ? 'header' : el.closest('footer') ? 'footer' : el.closest('.lang-banner') ? 'banner' : 'body';
          beacon({ t: 'ck', id: id, p: P, lb: label.slice(0, 80), hr: el.href || el.getAttribute('href') || '', z: zone });
        }, true);
      })();
    </script>
    {site.cfAnalyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.cfAnalyticsToken}"}`}></script>}
  </body>
</html>
