---
import Base from '@/layouts/Base.astro';
import type { Locale } from '@/config/site';
import { getDict, localizePath } from '@/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDict(lang);
---
<Base lang={lang} path="/404" title={t.notFound.title} noindex hideNotice>
  <section class="section center">
    <div class="narrow">
      <img src="/brand/mascot.webp" alt="" width="140" height="185" style="margin:0 auto 18px" />
      <h1 class="h2">{t.notFound.title}</h1>
      <p class="muted">{t.notFound.body}</p>
      <a class="btn btn--primary" href={localizePath('/', lang)}>{t.notFound.cta}</a>
    </div>
  </section>
</Base>
