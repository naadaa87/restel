{
  // 레스텔 RESTEL — Cloudflare Workers 설정
  // GitHub 저장소를 Cloudflare에 연결하면 이 파일을 읽어 자동 배포됩니다.
  // D1·R2는 ID 없이 선언되어 있어 첫 배포 때 Wrangler가 자동으로 생성(프로비저닝)합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restel",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
  "observability": { "enabled": true },
  // 대표 주소(SITE_URL)는 여기 두지 않는다. Cloudflare > Settings > Builds > Variables의 빌드 변수로 관리(astro.config.mjs 참고)
  "vars": {
    "DEFAULT_LOCALE": "ko"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "restel-db" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "restel-media" }
  ]
  // 시크릿(대시보드 Settings → Variables and Secrets 에서 입력):
  //   ADMIN_EMAIL       총괄관리자 로그인 이메일
  //   ADMIN_PASSWORD    총괄관리자 비밀번호 (12자 이상 권장)
  //   SESSION_SECRET    (선택) 로그인 세션 서명 키. 없으면 첫 로그인 때 자동 생성해 D1에 보관
  //   RESEND_API_KEY    (선택) 이메일 알림용 Resend API 키
  //   MAIL_FROM         (선택) 발신 주소, 예: RESTEL <hello@restel.kr>
  //   TURNSTILE_SITE_KEY / TURNSTILE_SECRET  (선택) 봇 차단
}
